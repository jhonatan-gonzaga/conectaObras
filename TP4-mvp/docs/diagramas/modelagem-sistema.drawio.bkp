    <diagram id="kCITKH4NhFN-4jJM8AND" name="Diagrama de Sequência 2 — Aceitar solicitação direta de serviço">
        <mxGraphModel dx="2348" dy="1620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Diagrama de Sequência — Aceitar solicitação direta de serviço\n\nautonumber\n\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 13\nskinparam sequenceMessageAlign center\nskinparam maxMessageSize 45\n\nskinparam sequence {\n  ArrowColor #34495E\n  LifeLineBorderColor #85929E\n  ParticipantBackgroundColor #EAF2F8\n  ParticipantBorderColor #2471A3\n  ActivationBackgroundColor #D6EAF8\n  ActivationBorderColor #2471A3\n}\n\nactor \&quot;Profissional\&quot; as profissional\nboundary \&quot;Aplicativo\&quot; as app\ncontrol \&quot;DirectRequestsController\&quot; as controller\ncontrol \&quot;DirectRequestsService\&quot; as requests\ncontrol \&quot;ContractCreationService\&quot; as creation\ncontrol \&quot;ConversationsService\&quot; as conversations\ncontrol \&quot;NotificationsService\&quot; as notifications\ndatabase \&quot;PrismaService / MySQL\&quot; as prisma\n\nprofissional -&gt; app : Selecionar Aceitar\nactivate app\n\napp -&gt; controller : POST /api/direct-requests/:id/accept\\naccept(user, id)\nactivate controller\n\nnote over controller\n  JwtAuthGuard autentica o usuário\n  antes da chamada ao método accept().\nend note\n\ncontroller -&gt; requests : accept(user.id, id)\nactivate requests\n\nrequests -&gt; creation : acceptDirectRequest(userId, id)\nactivate creation\n\ncreation -&gt; prisma : directRequest.findUnique({ where: { id } })\nactivate prisma\nprisma --&gt; creation : Solicitação com cliente e profissional\\nou null\ndeactivate prisma\n\nalt Solicitação inexistente\n  creation --&gt; requests : NotFoundException\n  requests --&gt; controller : Propagar erro\n  controller --&gt; app : Resposta de erro\n  app --&gt; profissional : Exibir motivo\n\nelse Outro profissional ou status diferente de SENT\n  creation --&gt; requests : ForbiddenException ou BadRequestException\n  requests --&gt; controller : Propagar erro\n  controller --&gt; app : Resposta de erro\n  app --&gt; profissional : Exibir motivo\n\nelse Profissional destinatário e status SENT\n\n  group prisma.$transaction(async tx =&gt; ...)\n\n    creation -&gt; prisma : tx.directRequest.update(...)\\nstatus = ACCEPTED\n    activate prisma\n    prisma --&gt; creation : Solicitação atualizada\n    deactivate prisma\n\n    creation -&gt; creation : createContract(tx, dados)\n    activate creation\n\n    creation -&gt; prisma : tx.contract.create(...)\\nstatus = PENDING_START\n    activate prisma\n    prisma --&gt; creation : Contrato criado\n    deactivate prisma\n\n    creation -&gt; prisma : tx.contractStatusHistory.create(...)\\ntoStatus = PENDING_START\n    activate prisma\n    prisma --&gt; creation : Histórico inicial registrado\n    deactivate prisma\n\n    deactivate creation\n\n    creation -&gt; conversations : attachDirectRequestToContract(\\nrequest.id, contract.id, tx)\n    activate conversations\n    conversations --&gt; creation : Conversa vinculada\n    deactivate conversations\n\n    creation -&gt; notifications : create(dados, tx)\n    activate notifications\n    notifications -&gt; prisma : tx.notification.create(...)\\nDIRECT_REQUEST_ACCEPTED\n    activate prisma\n    prisma --&gt; notifications : Notificação registrada\n    deactivate prisma\n    notifications --&gt; creation : Confirmação\n    deactivate notifications\n\n    creation -&gt; creation : findCreatedContract(tx, contract.id)\n    activate creation\n    creation -&gt; prisma : tx.contract.findUniqueOrThrow(...)\n    activate prisma\n    prisma --&gt; creation : Contrato com relações\n    deactivate prisma\n    deactivate creation\n\n  end\n\n  alt Transação confirmada\n    creation --&gt; requests : ContractWithRelations\n    requests --&gt; controller : ContractWithRelations\n    controller --&gt; app : HTTP 201 + contrato\n    app --&gt; profissional : Exibir contrato aguardando início\n\n  else Falha em uma operação da transação\n    creation --&gt; requests : Erro; transação desfeita\n    requests --&gt; controller : Propagar erro\n    controller --&gt; app : Resposta de erro\n    app --&gt; profissional : Exibir falha no aceite\n  end\n\nend\n\ndeactivate creation\ndeactivate requests\ndeactivate controller\ndeactivate app\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DJHnUb8OJw4zrBBBUE7H-1">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="" plantUmlId="pl_14" plantUmlBaseStyle="shape=umlLifeline;perimeter=lifelinePerimeter;participant=headless;size=74.31;lifelineMirror=1;dashPattern=5 5;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=none;strokeColor=#85929E;strokeWidth=0.5;fontSize=13;fontFamily=Arial;" plantUmlBaseValue="" id="DJHnUb8OJw4zrBBBUE7H-2">
