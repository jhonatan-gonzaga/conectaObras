    <diagram id="Y90In69HKPnM4zjqOPrO" name="diagrama de atividade - Aceitar solicitação direta de serviço">
        <mxGraphModel dx="1174" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Diagrama de Atividade — Aceitar solicitação direta de serviço\n\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 13\n\nskinparam activity {\n  BackgroundColor #EAF2F8\n  BorderColor #2471A3\n  DiamondBackgroundColor #FCF3CF\n  DiamondBorderColor #B7950B\n}\n\nstart\n\n:Profissional abre uma\\nsolicitação recebida;\n\n:Selecionar Aceitar;\n\n:Enviar solicitação de aceite;\n\n:Validar autenticação;\n\nif (Usuário autenticado?) then ([sim])\n\n  :Buscar solicitação direta;\n\n  if (Solicitação encontrada?) then ([sim])\n\n    :Verificar profissional destinatário;\n\n    if (É o destinatário?) then ([sim])\n\n      :Verificar status da solicitação;\n\n      if (Status é SENT?) then ([sim])\n\n        :Iniciar transação;\n\n        :Alterar solicitação\\npara ACCEPTED;\n\n        :Criar contrato com status\\nPENDING_START;\n\n        :Registrar histórico inicial\\ndo contrato;\n\n        :Vincular conversa existente\\nao contrato;\n\n        :Registrar notificação\\npara o cliente;\n\n        if (Todas as operações\\nforam concluídas?) then ([sim])\n\n          :Confirmar transação;\n\n          :Retornar contrato criado;\n\n          :Exibir contrato\\naguardando início;\n\n          stop\n\n        else ([não])\n\n          :Desfazer transação;\n\n          :Exibir falha no aceite;\n\n          stop\n\n        endif\n\n      else ([não])\n\n        :Informar que a solicitação\\nnão está pendente;\n\n        stop\n\n      endif\n\n    else ([não])\n\n      :Informar acesso negado;\n\n      stop\n\n    endif\n\n  else ([não])\n\n    :Informar solicitação\\nnão encontrada;\n\n    stop\n\n  endif\n\nelse ([não])\n\n  :Solicitar autenticação;\n\n  stop\n\nendif\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="HJxNz-4JaxCCpVNqgwCW-1">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
