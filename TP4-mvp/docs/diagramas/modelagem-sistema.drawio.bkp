    <diagram id="Asv4yLT5uMJFV2aWFJxd" name="diagrama de atividade Cadastrar produto da loja">
        <mxGraphModel dx="1528" dy="1921" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Diagrama de Atividade — Cadastrar produto da loja\n\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 13\n\nskinparam activity {\n  BackgroundColor #EAF2F8\n  BorderColor #2471A3\n  DiamondBackgroundColor #FCF3CF\n  DiamondBorderColor #B7950B\n}\n\nstart\n\n:Abrir formulário de\\ncadastro de produto;\n\n:Preencher nome, categoria,\\npreço, estoque e dados opcionais;\n\n:Selecionar Salvar;\n\n:Enviar solicitação de cadastro;\n\n:Validar autenticação,\\npapel LOJISTA e dados recebidos;\n\nif (Solicitação válida?) then ([sim])\n\n  :Buscar loja do proprietário;\n\n  if (Loja encontrada?) then ([sim])\n\n    :Consultar categoria do produto;\n\n    if (Categoria existente\\ne ativa?) then ([sim])\n\n      :Normalizar nome e validar\\nnome, preço e estoque;\n\n      if (Dados válidos?) then ([sim])\n\n        :Tentar persistir produto\\nvinculado à loja\\ncom status DRAFT;\n\n        if (Produto salvo?) then ([sim])\n\n          :Retornar produto cadastrado;\n\n          :Atualizar interface;\n\n          :Exibir confirmação\\ndo cadastro;\n\n          stop\n\n        else ([não])\n\n          if (SKU duplicado\\nna mesma loja?) then ([sim])\n            :Informar conflito de SKU;\n          else ([não])\n            :Informar falha na gravação;\n          endif\n\n          :Exibir motivo da falha;\n\n          stop\n\n        endif\n\n      else ([não])\n\n        :Informar erros de validação;\n\n        :Exibir campos que\\nprecisam de correção;\n\n        stop\n\n      endif\n\n    else ([não])\n\n      :Informar categoria\\ninexistente ou inativa;\n\n      :Exibir motivo da falha;\n\n      stop\n\n    endif\n\n  else ([não])\n\n    :Informar que a loja\\nnão foi encontrada;\n\n    :Exibir motivo da falha;\n\n    stop\n\n  endif\n\nelse ([não])\n\n  :Informar erro de autenticação,\\npermissão ou dados recebidos;\n\n  :Exibir motivo da falha;\n\n  stop\n\nendif\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hgP9WqBNjsMflKt32wcA-1">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
