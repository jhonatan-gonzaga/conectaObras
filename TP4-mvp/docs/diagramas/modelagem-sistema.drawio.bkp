                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Casos de Uso — Conecta Obras\n\nleft to right direction\n\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 13\nskinparam linetype ortho\nskinparam nodesep 60\nskinparam ranksep 80\n\nskinparam actor {\n  BorderColor #2471A3\n  FontColor #154360\n}\n\nskinparam usecase {\n  BackgroundColor #EAF2F8\n  BorderColor #2471A3\n  FontColor #154360\n}\n\nactor \&quot;Lojista\&quot; as lojista\nactor \&quot;Cliente\&quot; as cliente\nactor \&quot;Profissional\&quot; as profissional\nactor \&quot;Suporte\&quot; as suporte\n\nrectangle \&quot;Conecta Obras\&quot; {\n\n  usecase \&quot;Cadastrar produto\&quot; as cadastrarProduto\n  usecase \&quot;Alterar status\\ndo produto\&quot; as alterarProduto\n\n  usecase \&quot;Enviar solicitação\\ndireta\&quot; as enviarSolicitacao\n  usecase \&quot;Consultar solicitações\\nrecebidas\&quot; as consultarSolicitacoes\n  usecase \&quot;Aceitar solicitação\\ndireta\&quot; as aceitarSolicitacao\n  usecase \&quot;Recusar solicitação\\ndireta\&quot; as recusarSolicitacao\n  usecase \&quot;Criar contrato\&quot; as criarContrato\n\n  usecase \&quot;Consultar contrato\&quot; as consultarContrato\n  usecase \&quot;Atualizar status\\ndo contrato\&quot; as atualizarContrato\n  usecase \&quot;Registrar histórico\\nda alteração\&quot; as registrarHistorico\n  usecase \&quot;Notificar outra parte\&quot; as notificarParte\n\n  usecase \&quot;Solicitar suporte\&quot; as solicitarSuporte\n  usecase \&quot;Atender pelo chat\&quot; as atenderChat\n  usecase \&quot;Trocar mensagens\\nde texto\&quot; as trocarMensagens\n  usecase \&quot;Enviar áudio\&quot; as enviarAudio\n  usecase \&quot;Enviar imagem\&quot; as enviarImagem\n  usecase \&quot;Encaminhar atendimento\\npara WhatsApp\&quot; as encaminharWhatsApp\n  usecase \&quot;Registrar atendimento\\nem log\&quot; as registrarLog\n}\n\nlojista -- cadastrarProduto\nlojista -- alterarProduto\nlojista -- solicitarSuporte\n\ncliente -- enviarSolicitacao\ncliente -- consultarContrato\ncliente -- atualizarContrato\ncliente -- solicitarSuporte\n\nprofissional -- consultarSolicitacoes\nprofissional -- aceitarSolicitacao\nprofissional -- recusarSolicitacao\nprofissional -- consultarContrato\nprofissional -- atualizarContrato\nprofissional -- solicitarSuporte\n\nsuporte -- atenderChat\nsuporte -- encaminharWhatsApp\n\naceitarSolicitacao ..&gt; criarContrato : &lt;&lt;include&gt;&gt;\naceitarSolicitacao ..&gt; notificarParte : &lt;&lt;include&gt;&gt;\n\natualizarContrato ..&gt; registrarHistorico : &lt;&lt;include&gt;&gt;\natualizarContrato ..&gt; notificarParte : &lt;&lt;include&gt;&gt;\n\natenderChat ..&gt; trocarMensagens : &lt;&lt;include&gt;&gt;\natenderChat ..&gt; registrarLog : &lt;&lt;include&gt;&gt;\n\nenviarAudio ..&gt; atenderChat : &lt;&lt;extend&gt;&gt;\nenviarImagem ..&gt; atenderChat : &lt;&lt;extend&gt;&gt;\nencaminharWhatsApp ..&gt; atenderChat : &lt;&lt;extend&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AvRe9_jYdLRbUyAn5GsA-1">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
