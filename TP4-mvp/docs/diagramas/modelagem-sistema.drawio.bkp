                        <mxGeometry height="1612.6699999999998" width="73.02982142857142" x="50.00000000000001" y="60.95" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="Profissional" plantUmlId="p_77" plantUmlBaseStyle="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;spacingTop=-5;fillColor=#E2E2F0;strokeColor=#181818;fontColor=#000000;fontSize=13;html=1;shadow=0;fontFamily=Arial;part=1;" plantUmlBaseValue="Profissional" id="DJHnUb8OJw4zrBBBUE7H-3">
                    <mxCell parent="DJHnUb8OJw4zrBBBUE7H-2" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;spacingTop=-5;fillColor=#E2E2F0;strokeColor=#181818;fontColor=#000000;fontSize=13;html=1;shadow=0;fontFamily=Arial;part=1;" vertex="1">
                        <mxGeometry height="58" width="26" x="23.514910714285712" y="0.5" as="geometry"/>
