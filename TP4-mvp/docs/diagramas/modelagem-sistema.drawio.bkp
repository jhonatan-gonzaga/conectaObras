    <diagram id="FrJ4eTXW3ZfqX6drRxFr" name="diagrama de atividade - Atualizar status do contrato">
        <mxGraphModel dx="1174" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Atualizar status do contrato\n\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 13\nskinparam ArrowColor #34495E\n\nskinparam activity {\n  BackgroundColor #EAF2F8\n  BorderColor #2471A3\n  DiamondBackgroundColor #FCF3CF\n  DiamondBorderColor #B7950B\n}\n\nskinparam note {\n  BackgroundColor #FFF8DC\n  BorderColor #B7950B\n}\n\nstart\n\n:Selecionar ação de\\natualização do contrato;\n\n:Enviar solicitação\\nde atualização;\n\n:Validar autenticação\\ne dados recebidos;\n\nif (Solicitação válida?) then ([sim])\n\n  :Buscar contrato;\n\n  if (Contrato encontrado?) then ([sim])\n\n    :Verificar participação\\ndo usuário;\n\n    if (Usuário participa\\ndo contrato?) then ([sim])\n\n      :Identificar ator, estado atual\\ne existência de avaliação;\n\n      :Validar transição de status;\n\n      note left\n        A permissão depende:\n        • do cliente ou profissional;\n        • do estado atual;\n        • do estado solicitado.\n\n        Contrato avaliado não\n        pode ser reaberto.\n      end note\n\n      if (Transição permitida?) then ([sim])\n\n        :Executar atualização\\nem transação;\n\n        note left\n          Na mesma transação:\n          1. Atualizar status do contrato.\n          2. Registrar histórico.\n          3. Registrar notificação\n             para a outra parte.\n\n          Uma falha interrompe\n          as operações restantes.\n        end note\n\n        if (Operações concluídas\\ncom sucesso?) then ([sim])\n\n          :Confirmar transação;\n\n          :Retornar contrato atualizado;\n\n          :Exibir novo status\\ndo contrato;\n\n          stop\n\n        else ([não])\n\n          :Desfazer transação;\n\n          :Retornar erro\\nde atualização;\n\n          :Exibir motivo da falha;\n\n          stop\n\n        endif\n\n      else ([não])\n\n        :Retornar motivo da\\ntransição negada;\n\n        :Exibir motivo da falha;\n\n        stop\n\n      endif\n\n    else ([não])\n\n      :Retornar erro:\\nacesso não permitido;\n\n      :Exibir motivo da falha;\n\n      stop\n\n    endif\n\n  else ([não])\n\n    :Retornar erro:\\ncontrato não encontrado;\n\n    :Exibir motivo da falha;\n\n    stop\n\n  endif\n\nelse ([não])\n\n  :Retornar erro de\\nautenticação ou validação;\n\n  :Exibir motivo da falha;\n\n  stop\n\nendif\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="S_ZUAwVoDcumfg6wG6tW-1">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
                </UserObject>
