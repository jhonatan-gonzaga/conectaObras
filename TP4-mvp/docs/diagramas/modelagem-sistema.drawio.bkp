    <diagram id="2SrsbSPtVRdgAtVOcJIn" name="Diagrama de implantação_ Conecta Obras">
        <mxGraphModel dx="2001" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Diagrama de Implantação — Conecta Obras\\nProposta de ambiente de produção\n\ntop to bottom direction\n\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 13\nskinparam nodesep 55\nskinparam ranksep 65\nskinparam linetype ortho\n\nskinparam node {\n  BackgroundColor #EAF2F8\n  BorderColor #2471A3\n  FontColor #154360\n}\n\nskinparam artifact {\n  BackgroundColor #FFFFFF\n  BorderColor #566573\n}\n\nnode \&quot;Dispositivo do usuário\\nSmartphone\&quot; as dispositivo &lt;&lt;device&gt;&gt; {\n  node \&quot;Android / iOS\&quot; as mobile &lt;&lt;executionEnvironment&gt;&gt; {\n    artifact \&quot;Aplicativo Conecta Obras\\nBuild mobile React Native / Expo\&quot; as app\n  }\n}\n\nnode \&quot;Gateway de segurança\&quot; as seguranca &lt;&lt;device&gt;&gt; {\n  artifact \&quot;Configuração do firewall\\nRegras de acesso à rede\&quot; as firewall\n}\n\nnode \&quot;Servidor de comunicação\\nHost do proxy reverso\&quot; as comunicacao &lt;&lt;device&gt;&gt; {\n  node \&quot;Proxy reverso\\nNginx — proposto\&quot; as proxy &lt;&lt;executionEnvironment&gt;&gt; {\n    artifact \&quot;Configuração de rotas\\n/api/ e /uploads/\&quot; as rotas\n    artifact \&quot;Certificado TLS\&quot; as certificado\n  }\n}\n\nnode \&quot;Servidor de aplicação\\nHost do backend\&quot; as servidorApp &lt;&lt;device&gt;&gt; {\n  node \&quot;Node.js\&quot; as runtime &lt;&lt;executionEnvironment&gt;&gt; {\n    artifact \&quot;API Conecta Obras\\nAplicação NestJS compilada\\ndist/\&quot; as api\n    artifact \&quot;Prisma Client\\nBiblioteca de acesso a dados\&quot; as prisma\n  }\n\n  artifact \&quot;Arquivos de mídia\\nDiretório uploads/\\nem volume persistente\&quot; as midias\n  artifact \&quot;Configuração de execução\\nDATABASE_URL, JWT_SECRET,\\nHOST e PORT\&quot; as configuracao\n}\n\nnode \&quot;Servidor de banco de dados\\nHost de persistência\&quot; as servidorBD &lt;&lt;device&gt;&gt; {\n  node \&quot;MySQL\&quot; as mysql &lt;&lt;executionEnvironment&gt;&gt; {\n    artifact \&quot;Schema Conecta Obras\\nTabelas, índices e relacionamentos\&quot; as schema\n  }\n}\n\ndispositivo -- seguranca : Internet\\nHTTPS / TCP 443\nseguranca -- comunicacao : Tráfego HTTPS permitido\\nTCP 443\ncomunicacao -- servidorApp : Rede privada\\nHTTP / TCP 3000\\n/api/ e /uploads/\nservidorApp -- servidorBD : Rede privada\\nProtocolo MySQL / TCP 3306\n\napi ..&gt; prisma : utiliza\napi ..&gt; configuracao : lê na inicialização\napi ..&gt; midias : grava e disponibiliza\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ixHM2C8os_ve55_LKxMl-1">
